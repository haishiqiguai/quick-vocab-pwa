{
  "name": "quick-vocab-pwa",
  "private": true,
  "version": "1.0.5",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:data": "node scripts/build-exam-words.mjs && node scripts/build-guide-words.mjs",
    "build:speech": "node scripts/build-bundled-speech.mjs && node scripts/build-bundled-meaning-speech.mjs",
    "verify:speech": "node scripts/verify-bundled-speech.mjs",
    "build:android:web": "npm run build:data && npm run verify:speech && tsc --noEmit && set QUICK_VOCAB_TARGET=android&& set VITE_NATIVE_APP=1&& vite build && node scripts/stage-android-audio.mjs",
    "android:sync": "npm run build:android:web && cap sync android",
    "android:open": "cap open android",
    "android:debug": "npm run android:sync && powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/run-android-gradle.ps1 debug && node scripts/copy-apk.mjs debug",
    "android:release": "npm run android:sync && powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/run-android-gradle.ps1 release && node scripts/copy-apk.mjs release",
    "preview": "node server/index.mjs --local",
    "serve:mobile": "node server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.2",
    "date-fns": "^4.1.0",
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^1.1.7",
    "lucide-react": "^0.468.0",
    "msedge-tts": "^2.0.7",
    "papaparse": "^5.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-swipeable": "^7.0.2",
    "read-excel-file": "^9.3.10"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.2",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.5",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^27.0.0",
    "typescript": "^5.7.2",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
